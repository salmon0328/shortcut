# Copy to .env. Anything here only fills in what your shell leaves unset.
# .env is gitignored. Never commit it or paste it anywhere once it has keys.

# --- AWS ---
# Either fill in a key pair here, or leave both blank and use the AWS CLI
# (`aws configure`), which stores them outside the repository. If the CLI
# made a named profile, put its name in AWS_PROFILE.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Temporary keys from the AWS access portal (ids starting ASIA) come as a
# set of three and expire within hours; paste the token here too. Permanent
# keys (ids starting AKIA) leave this blank.
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1
AWS_PROFILE=

# --- the plain-language layer ---
MODEL_ID=
MOCK_MODE=true

# --- shared photos and floorplans ---
# Leave empty to keep uploads on this machine, in data/photos and
# data/floorplans. Name a bucket to share them with the team; you also
# need AWS credentials that can read and write it.
SHORTCUT_S3_BUCKET=
