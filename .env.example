# Copy to .env. Anything here only fills in what your shell leaves unset.
# .env is gitignored. Never commit it or paste it anywhere once it has keys.

# --- AWS ---
# Either fill in a key pair here, or leave both blank and use the AWS CLI
# (`aws configure`), which stores them outside the repository. If the CLI
# made a named profile, put its name in AWS_PROFILE.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Temporary keys from the AWS access portal (ids starting ASIA) come as a
# set of three and expire within hours; paste the token here too. Permanent
# keys (ids starting AKIA) leave this blank.
AWS_SESSION_TOKEN=
AWS_REGION=ap-southeast-1
# Where to call Bedrock, if that is not where everything else lives. Worth
# having separate: an organisation policy can deny Bedrock inference in most
# regions and allow it in one, while the photo bucket sits somewhere else
# again, and folding both into AWS_REGION means fixing one by breaking the
# other. Leave blank to use AWS_REGION.
#
# On the hackathon account this is not hypothetical: a service control policy
# explicitly denies bedrock:InvokeModel in ap-southeast-1, and us-east-1 is
# where it works. Run `python scripts/check_bedrock.py` - it says which
# region and model id this account can actually call.
BEDROCK_REGION=us-east-1
AWS_PROFILE=

# --- the plain-language layer ---
# Which prefix a model id needs depends on the region: the same model is
# "global.", "apac." or "us." depending on where it is called, and only one
# of them resolves in any given one. us-east-1 serves the "us." profiles.
MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# true runs against canned answers with no AWS at all. false uses Bedrock.
MOCK_MODE=true

# --- shared photos and floorplans ---
# Leave empty to keep uploads on this machine, in data/photos and
# data/floorplans. Name a bucket to share them with the team; you also
# need AWS credentials that can read and write it.
SHORTCUT_S3_BUCKET=
